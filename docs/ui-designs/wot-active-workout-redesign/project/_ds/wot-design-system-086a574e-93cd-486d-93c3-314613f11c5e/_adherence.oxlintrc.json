{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/home/**",
              "components/insights/**",
              "components/overlay/**",
              "components/workout/**",
              "ui_kits/mobile-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Inter, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ActionCard> doesn't accept that prop. Declared props: title, subtitle, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActiveSessionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|exercises|elapsed|onPress|key|ref|className|style|children)$/]",
        "message": "<ActiveSessionBar> doesn't accept that prop. Declared props: label, exercises, elapsed, onPress."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|onSettings|showSettings|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: logoSrc, onSettings, showSettings."
      },
      {
        "selector": "JSXOpeningElement[name.name='BalanceBars'] > JSXAttribute > JSXIdentifier[name!=/^(?:shares|title|key|ref|className|style|children)$/]",
        "message": "<BalanceBars> doesn't accept that prop. Declared props: shares, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|trailing|disabled|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, trailing, disabled, fullWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|size|tone|onClick|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, selected, size, tone, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm|xs)$/]",
        "message": "<Chip> size must be one of 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|ink)$/]",
        "message": "<Chip> tone must be one of 'muted' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataState'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|actionLabel|onAction|loading|key|ref|className|style|children)$/]",
        "message": "<DataState> doesn't accept that prop. Declared props: message, actionLabel, onAction, loading."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|bodyRegions|supersetGroup|mode|sets|intensity|lastReference|onLogSet|onRemove|key|ref|className|style|children)$/]",
        "message": "<ExerciseBlock> doesn't accept that prop. Declared props: name, bodyRegions, supersetGroup, mode, sets, intensity, lastReference, onLogSet, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseBlock'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:strength|cardio|flexibility)$/]",
        "message": "<ExerciseBlock> mode must be one of 'strength' | 'cardio' | 'flexibility'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExerciseBlock'] > JSXAttribute[name.name='intensity'] > Literal[value!=/^(?:rir|rpe)$/]",
        "message": "<ExerciseBlock> intensity must be one of 'rir' | 'rpe'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadTrendChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:weeks|verdict|caption|baselineReady|key|ref|className|style|children)$/]",
        "message": "<LoadTrendChart> doesn't accept that prop. Declared props: weeks, verdict, caption, baselineReady."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<MetricRow> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingScale'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|min|max|lowLabel|highLabel|key|ref|className|style|children)$/]",
        "message": "<RatingScale> doesn't accept that prop. Declared props: value, onChange, min, max, lowLabel, highLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Screen'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|ruled|style|key|ref|className|style|children)$/]",
        "message": "<Screen> doesn't accept that prop. Declared props: children, ruled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionHistoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:dayName|dateStr|title|type|srpe|duration|onClick|key|ref|className|style|children)$/]",
        "message": "<SessionHistoryCard> doesn't accept that prop. Declared props: dayName, dateStr, title, type, srpe, duration, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:setNumber|mode|values|intensity|lastReference|copyable|onLog|onDelete|key|ref|className|style|children)$/]",
        "message": "<SetRow> doesn't accept that prop. Declared props: setNumber, mode, values, intensity, lastReference, copyable, onLog, onDelete."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetRow'] > JSXAttribute[name.name='intensity'] > Literal[value!=/^(?:rir|rpe)$/]",
        "message": "<SetRow> intensity must be one of 'rir' | 'rpe'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, onClose, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|details|positive|defaultExpanded|key|ref|className|style|children)$/]",
        "message": "<SignalCard> doesn't accept that prop. Declared props: title, body, details, positive, defaultExpanded."
      },
      {
        "selector": "JSXOpeningElement[name.name='StrengthProgression'] > JSXAttribute > JSXIdentifier[name!=/^(?:trends|key|ref|className|style|children)$/]",
        "message": "<StrengthProgression> doesn't accept that prop. Declared props: trends."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|version|activeSession|onOpenSession|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: active, onChange, version, activeSession, onOpenSession."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|tracking|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, tone, size, tracking, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|primary|destructive)$/]",
        "message": "<TextLink> tone must be one of 'muted' | 'primary' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnderlineInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|size|type|focusAccent|style|key|ref|className|style|children)$/]",
        "message": "<UnderlineInput> doesn't accept that prop. Declared props: label, value, onChange, placeholder, size, type, focusAccent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnderlineInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:auth|body|title|stat)$/]",
        "message": "<UnderlineInput> size must be one of 'auth' | 'body' | 'title' | 'stat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VersionFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:version|key|ref|className|style|children)$/]",
        "message": "<VersionFooter> doesn't accept that prop. Declared props: version."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:loads|summary|label|key|ref|className|style|children)$/]",
        "message": "<WeekStrip> doesn't accept that prop. Declared props: loads, summary, label."
      }
    ]
  },
