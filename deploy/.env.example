# Copy to .env on the server (deploy/.env) and fill in.
# wot-api (required)
DATABASE_URL=postgresql://wot:wot_dev_password@host.docker.internal:5432/wot_dev
API_URL=https://wot-api.lau-soft.com
CORS_ORIGIN=https://wot-api.lau-soft.com
# openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-bytes

# cloudflared (required)
TUNNEL_TOKEN=replace-me-with-zero-trust-tunnel-token

# watchtower uses docker's credential store: run `docker login ghcr.io` on the
# host once (needs a PAT with read:packages if the image stays private).