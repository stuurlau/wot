# Copy to deploy/.env ON THE SERVER, then fill in. The api container resolves
# "localhost" as itself, so the DB URL must use host.docker.internal (db runs
# on the same machine — plain loopback, no TLS needed) or the db's compose
# service name (attach this stack to the db's network).
DATABASE_URL=postgresql://wot_dev:UPDATE_PASSWORD_HERE@host.docker.internal:5432/wot_dev?sslmode=disable
# If the db enforces TLS even for local connections, mount the cert dir:
#   DATABASE_URL=...@host.docker.internal:5432/wot_dev?sslmode=verify-ca&sslrootcert=/certs/wot-server.crt
#   and add a volume "- ${HOME}/.certs:/certs:ro" to the wot-api service.

API_URL=https://api.wot-app.org
CORS_ORIGIN=https://api.wot-app.org
# openssl rand -hex 32
BETTER_AUTH_SECRET=fill-in-64-hex-chars

# Zero Trust -> Networks -> Tunnels -> created tunnel's token
TUNNEL_TOKEN=fill-me-in

# deploy.sh pulls via `docker compose pull`; if the GHCR package stays
# private, run `docker login ghcr.io` once on the server (PAT with
# read:packages) so the pull and image inspection work.
