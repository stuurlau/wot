# Local development (docker compose db)
DATABASE_URL=postgresql://wot:wot_dev_password@localhost:5433/wot_dev

# Home server (on home network only)
# DATABASE_URL=postgresql://user:pass@BIG.local:5432/wot_dev?sslmode=verify-ca&sslrootcert=$HOME/.certs/wot-server.crt

API_HOST=0.0.0.0
API_PORT=3000
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8081

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace_with_openssl_rand_hex_32

# Password-reset mail via Resend (resend.com → API keys). Unset = codes are
# logged instead of mailed. MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
# MAIL_FROM=WOT <noreply@wot-app.org>
